{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListBucketOnly",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::YOUR_BUCKET"
        },
        {
            "Sid": "ReadWriteEtlPrefixes",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:AbortMultipartUpload"
            ],
            "Resource": [
                "arn:aws:s3:::YOUR_BUCKET/raw/*",
                "arn:aws:s3:::YOUR_BUCKET/clean/*",
                "arn:aws:s3:::YOUR_BUCKET/rejected/*"
            ]
        }
    ]
}